{
  "name": "jobhunt-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx apps/cli/src/index.ts",
    "ingest": "tsx apps/cli/src/index.ts ingest",
    "score": "tsx apps/cli/src/index.ts score",
    "digest": "tsx apps/cli/src/index.ts digest",
    "db:push": "drizzle-kit push --config=packages/db/drizzle.config.ts",
    "api": "tsx apps/api/src/server.ts",
    "api:dev": "tsx watch apps/api/src/server.ts",
    "openapi": "tsx apps/api/src/openapi.ts",
    "web": "pnpm --filter @jobhunt/web dev",
    "web:build": "pnpm --filter @jobhunt/web build",
    "db:migrate": "drizzle-kit migrate --config=packages/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=packages/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=packages/db/drizzle.config.ts",
    "registry:sync": "tsx apps/cli/src/index.ts registry:sync",
    "extension:icons": "python scripts/generate_extension_icons.py"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.5",
    "yaml": "^2.6.1",
    "zod": "^4.4.3"
  }
}