# ---- Database (Phase 0 can run fully without this; JSON output works standalone) ----
DATABASE_URL=postgres://jobhunt:jobhunt@localhost:5433/jobhunt
REDIS_URL=redis://localhost:6380

# ---- API ----
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Optional on localhost; REQUIRED before you bind to 0.0.0.0.
API_KEY=
# Origins the console is served from, comma separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
REGISTRY_PATH=config/companies.yaml

# ---- Web console (Vite) ----
# NOTE: VITE_* values are compiled into the browser bundle and visible to anyone who can load
# the console. Only use a key here for a local, single-user setup; never deploy it publicly.
VITE_API_URL=http://localhost:4000
VITE_API_KEY=

# ---- Runtime LLM (Phase 1+). Keep OFF your $100 Claude build credits. ----
# Use a cheap model for high-volume extraction/classification.
ANTHROPIC_API_KEY=
LLM_MODEL_CHEAP=claude-haiku-4-5
LLM_MODEL_STRONG=claude-sonnet-4-5
LLM_MONTHLY_BUDGET_USD=15

# ---- Phase 4 ----
POSTMARK_TOKEN=
OUTREACH_FROM_DOMAIN=
HUNTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
